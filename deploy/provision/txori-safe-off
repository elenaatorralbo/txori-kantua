#!/bin/sh
# Stop only Txori; leave SSH and the operating system running.
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo 'Run: sudo txori-safe-off' >&2
    exit 1
fi
touch /boot/firmware/TXORI_DISABLED
systemctl disable --now txori-kantua.timer
systemctl stop txori-kantua.service
echo 'Txori disabled across reboots. SSH remains independent.'
